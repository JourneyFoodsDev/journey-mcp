# Copy to .env (never commit .env). All values below are placeholders.

# Journey developer API (ingredients, nutrients, allergens). Header: x-api-key
# Default for local npx: https://devapi.journeyfoods.io. Set this only to override.
# Keys are issued at https://dev.journeyfoods.io. A price-feed key is not accepted here.
# Hosted Worker during the Nov 2 2026 Atlas outage (see worker/wrangler.jsonc):
#   JOURNEY_API_BASE_URL=https://journey-fallback.journeyfoods.workers.dev/x/devapi
#   JOURNEY_SUPPLIER_API_BASE_URL=https://journey-fallback.journeyfoods.workers.dev/x/mcp
#   JOURNEY_APP_API_BASE_URL=https://journey-fallback.journeyfoods.workers.dev/x/mcp
# Rollback when Atlas is back is in mcp_rollback_vars.json (Cloud Run + devapi). Do not commit Mongo URIs.
JOURNEY_API_BASE_URL=
JOURNEY_API_KEY=

# Supplier profiles live only on an internal backend (GET /api/v1/supplier/profiles).
# There is no default URL. JOURNEY_SUPPLIER_API_KEY is sent as x-journey-service-key.
# A user's JOURNEY_API_KEY or JOURNEY_PRICE_API_KEY is never sent there.
# Leave the base unset for local npx: supplier tools point at https://mcp.journeyfoods.io/mcp.
JOURNEY_SUPPLIER_API_BASE_URL=
JOURNEY_SUPPLIER_API_KEY=
# Price feed. Default: https://price.journeyfoods.io (/api/v1/commodities, quote, history, forecast).
# Set JOURNEY_PRICE_API_BASE_URL only to override.
# JOURNEY_API_KEY is reused as the price key only when the two base URLs are the same.
# Free 14-day trial keys (100 calls) come from POST /api/v1/keys/trial on the price feed, or its /trial page.
JOURNEY_PRICE_API_BASE_URL=
JOURNEY_PRICE_API_KEY=
# Journey Labs verification lookup path, e.g. /api/v1/lab-results/verify on the app API
JOURNEY_LABS_VERIFY_PATH=

# Account lookup for API key callers. Must return {"account_id": "...", "tier": "..."}.
# Optional. API-key identity prefers GET {JOURNEY_PRICE_API_BASE_URL}/api/v1/account
# (company or account id). Without a stable id there, caps stay on a hash of the key.
JOURNEY_KEY_LOOKUP_URL=

# HMAC key for x-journey-end-user (hex signature of the header). On the Worker this is the
# Secrets Store binding JOURNEY_END_USER_SIGNING_SECRET in store default_secrets_store.
# If unset, those headers are not sent. Never commit a real value.
JOURNEY_END_USER_SIGNING_SECRET=

# Data access policy file (tiers, caps, rate limits). Defaults to built-in policy.
JOURNEY_POLICY_FILE=
# Usage store: memory (default) or file
JOURNEY_USAGE_STORE=memory
JOURNEY_USAGE_FILE=.journey-mcp-usage.json

# Remote (Streamable HTTP) mode
PORT=3000
HOST=127.0.0.1
MCP_RESOURCE_URL=http://localhost:3000/mcp
MCP_ALLOWED_ORIGINS=

# Auth0 tenant for the ChatGPT apps. These are not secrets. The issuer keeps its trailing slash.
# Access tokens are RS256. App audiences are the MCP URLs. Scopes are catalog:read and profile:read.
OAUTH_ISSUER=https://dev-ssk71qghv0z5qp7s.us.auth0.com/
OAUTH_JWKS_URL=https://dev-ssk71qghv0z5qp7s.us.auth0.com/.well-known/jwks.json
OAUTH_JWT_ALGS=RS256
# Private JWK JSON for the builtin authorization server. Never commit a real key.
# OAUTH_JWT_PRIVATE_JWK=
# OpenAI domain challenge. Served at /.well-known/openai-apps-challenge only when set.
# OPENAI_APPS_CHALLENGE=
# Guava catalog. The hosted Worker reads D1 journey-fallback-guava (binding GUAVA_D1)
# and does not need this URL. Other processes can call the read-only routes on this host
# after that binding is deployed:
# GUAVA_API_BASE_URL=https://mcp.journeyfoods.io/apps/guava
GUAVA_API_BASE_URL=
OAUTH_INTROSPECTION_URL=
OAUTH_INTROSPECTION_CLIENT_ID=
OAUTH_INTROSPECTION_CLIENT_SECRET=
OAUTH_REQUIRED_SCOPE=journey:read
OAUTH_ACCOUNT_CLAIM=journey_account_id
OAUTH_TIER_CLAIM=journey_tier

LOG_LEVEL=info

# Usage events (one structured event per tool call: account, tier, tool, records, cap use, client, latency; no arguments or data)
# JOURNEY_USAGE_EVENTS=off
# JOURNEY_USAGE_EVENTS_FILE=./usage-events.ndjson
